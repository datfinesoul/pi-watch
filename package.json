{
  "name": "@datfinesoul/pi-watch",
  "version": "0.4.0",
  "description": "A Pi extension with a native macOS companion app for monitoring session status across Kitty panes.",
  "type": "module",
  "license": "MIT",
  "author": "Philip Hadviger <613305+datfinesoul@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datfinesoul/pi-watch.git"
  },
  "homepage": "https://github.com/datfinesoul/pi-watch#readme",
  "bugs": {
    "url": "https://github.com/datfinesoul/pi-watch/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "watch"
  ],
  "files": [
    "extensions/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --test",
    "pack:check": "node scripts/pack-check.mjs",
    "check:app": "node scripts/check-app.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/watch/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "acp": {
    "companionApps": [
      { "platform": "darwin", "path": "apps/macos", "check": "check:app" }
    ]
  }
}
